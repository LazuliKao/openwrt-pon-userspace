#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=80
STOP=20

USE_PROCD=1
PROG=/usr/sbin/fttrd

start_service() {
	# Only start on H3C HM2004-DU
	board=$(cat /tmp/sysinfo/board_name 2>/dev/null)
	if [ "$board" != "h3c,hm2004-du" ]; then
		return 0
	fi

	echo "[*] Initializing H3C FTTR Micro-OLT Subsystem..."

	# 1. Program FPGA Bitstream if needed (fallback if not auto-loaded by driver)
	if [ -f /lib/firmware/FTTR_TOP.sbit ] && [ ! -e /sys/devices/platform/fmcs/reload_fpga ]; then
		/usr/sbin/fttrctl load-fpga /lib/firmware/FTTR_TOP.sbit 2>/dev/null || true
	fi

	# 2. Setup downstream DSA switch ports (fttr1 ~ fttr16)
	for i in $(seq 1 16); do
		dev="fttr${i}"
		if [ -d "/sys/class/net/${dev}" ]; then
			ip link set "$dev" up 2>/dev/null
			ip link set "$dev" master br-lan 2>/dev/null || brctl addif br-lan "$dev" 2>/dev/null
		fi
	done

	# 3. Start Controller Daemon
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	echo "[*] Stopping H3C FTTR Subsystem..."
}
