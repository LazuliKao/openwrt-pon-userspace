#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=80
STOP=20

USE_PROCD=1
PROG=/usr/sbin/fttrd

start_service() {
	# Only start on H3C HM2004-DU
	board=$(cat /tmp/sysinfo/board_name 2>/dev/null)
	if [ "$board" != "h3c,hm2004-du" ]; then
		return 0
	fi

	echo "[*] Initializing H3C FTTR Micro-OLT Subsystem..."

	# 1. Program FPGA Bitstream if present
	if [ -f /lib/firmware/FTTR_TOP.sbit ]; then
		/usr/sbin/open_fpga_load /lib/firmware/FTTR_TOP.sbit
	fi

	# 2. Setup interfaces
	ip link set eth1 up 2>/dev/null
	ip link add link eth1 name eth1.1 type vlan id 1 2>/dev/null
	ip link set eth1.1 up 2>/dev/null
	ip link set eth1.1 master br-lan 2>/dev/null || brctl addif br-lan eth1.1 2>/dev/null

	# 3. Start Controller Daemon
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	echo "[*] Stopping H3C FTTR Subsystem..."
}
